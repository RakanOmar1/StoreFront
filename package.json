{
  "name": "storefront-heroku-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "postinstall": "npm ci --include=dev --prefix backend",
    "build": "npm run build --prefix backend",
    "heroku-postbuild": "npm run build && npm prune --omit=dev --prefix backend",
    "start": "npm start --prefix backend",
    "test": "npm test --prefix backend"
  }
}
