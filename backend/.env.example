# Heroku supplies DATABASE_URL when Heroku Postgres is attached. Leave it unset
# during local development when using the POSTGRES_* variables below.
# DATABASE_URL=postgresql://database-user:database-password@database-host:5432/database-name
NODE_ENV=development

POSTGRES_HOST=127.0.0.1
POSTGRES_DB=storefront
POSTGRES_TEST_DB=storefront_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432
BCRYPT_PASSWORD=replace-with-a-long-random-password-pepper
SALT_ROUNDS=10
TOKEN_SECRET=replace-with-a-long-random-jwt-secret
PORT=3000
CORS_ORIGINS=https://your-frontend.example.com
# Optional one-time bootstrap. Omit both variables when an admin already exists.
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-unique-password
